# Semafor Provozu: konfigurace serveru (zkopírovat do C:\apps\semafor\.env a vyplnit).
# Soubor obsahuje tajemství: práva NTFS jen pro servisní účet a administrátory.

# production | test   (test = nadpis "Semafor Provozu TEST" a štítek v aplikaci)
SEMAFOR_ENVIRONMENT=production

# Veřejná adresa přesně tak, jak ji vidí prohlížeč, VČETNĚ cesty (bez lomítka na konci).
SEMAFOR_PUBLIC_URL=https://apps.hranipex.local/semafor

# SQL Server: Windows autentizace servisního účtu (gMSA) nebo SQL login.
SEMAFOR_DATABASE_URL=mssql+pyodbc://@SQLSRV01/SemaforProvozu?driver=ODBC+Driver+18+for+SQL+Server&trusted_connection=yes&Encrypt=yes
# SEMAFOR_DATABASE_URL=mssql+pyodbc://semafor_app:HESLO@SQLSRV01/SemaforProvozu?driver=ODBC+Driver+18+for+SQL+Server&Encrypt=yes

# Relace: náhodný řetězec alespoň 32 znaků (PowerShell: [Convert]::ToBase64String((1..48|%{Get-Random -Max 256})))
SEMAFOR_SESSION_SECRET=
SEMAFOR_SESSION_MAX_AGE_S=36000
# lax (výchozí) | none (jen pro záložku v Teams)
SEMAFOR_SESSION_SAME_SITE=lax

# oidc = Entra ID | ldap = Active Directory (přechodně, dokud není registrace v Entra ID)
SEMAFOR_AUTH_MODE=oidc

# Entra ID (docs/ENTRA_ID.md). Nevyplněné se převezmou ze sdíleného C:\jja\.env (ENTRA_TENANT_ID, ENTRA_CLIENT_ID, ENTRA_CLIENT_SECRET).
SEMAFOR_OIDC_TENANT_ID=73b39313-1d97-4ac4-bc26-f0ba6dc67f1a
SEMAFOR_OIDC_CLIENT_ID=
SEMAFOR_OIDC_CLIENT_SECRET=
SEMAFOR_ROLE_ADMIN=Semafor.Admin
SEMAFOR_ROLE_USER=Semafor.User
SEMAFOR_ROLE_READER=Semafor.Reader
SEMAFOR_REQUIRE_ROLE=true

# LDAP (jen při SEMAFOR_AUTH_MODE=ldap). Server "hranipex.net" nebo "ldaps://hranipex.net".
SEMAFOR_LDAP_SERVER=hranipex.net
SEMAFOR_LDAP_DOMAIN=hranipex.net
# Role: uživatelská jména v AD (jmeno.prijmeni) nebo e-maily, oddělené čárkou. Kdo není v žádném seznamu, nemá přístup.
SEMAFOR_LDAP_ADMINS=
SEMAFOR_LDAP_USERS=
SEMAFOR_LDAP_READERS=

# Provoz přes HTTP bez TLS (jen dočasně, dokud není certifikát): heslo i relace jdou sítí nešifrovaně.
SEMAFOR_ALLOW_INSECURE_HTTP=false

# Našeptávač vlastníka i z Entra ID (aplikační oprávnění User.ReadBasic.All s admin consent)
SEMAFOR_GRAPH_DIRECTORY_SEARCH=false

# Prohlížeč
SEMAFOR_ALLOW_GOOGLE_FONTS=true
# Pro záložku v Teams (celé v uvozovkách): "'self' https://teams.microsoft.com https://*.teams.microsoft.com https://*.cloud.microsoft"
SEMAFOR_FRAME_ANCESTORS="'self'"

# Notifikace (zůstávají vypnuté, dokud není NOTIFY_ENABLED=true)
SEMAFOR_NOTIFY_ENABLED=false
# log | smtp | graph
SEMAFOR_NOTIFY_TRANSPORT=log
SEMAFOR_NOTIFY_FROM=semafor@hranipex.com
SEMAFOR_NOTIFY_DAILY_SUMMARY_TO=jan.kratky@hranipex.com
SEMAFOR_NOTIFY_COPY_OVERDUE_TO=jan.kratky@hranipex.com
SEMAFOR_NOTIFY_MAX_MAILS_PER_RUN=25
SEMAFOR_SMTP_HOST=
SEMAFOR_SMTP_PORT=25
SEMAFOR_SMTP_STARTTLS=true
SEMAFOR_SMTP_USER=
SEMAFOR_SMTP_PASSWORD=

# Logy (kromě standardního výstupu služby)
SEMAFOR_LOG_LEVEL=INFO
SEMAFOR_LOG_DIR=C:\apps\semafor\logs
